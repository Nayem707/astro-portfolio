---
import BaseHead, { type Props as HeadProps } from '../components/navigation/BaseHead.astro';
import Navbar from '../components/navigation/Navbar.astro';
import Footer from '../components/navigation/Footer.astro';
import '../styles/global.css';

type Props = HeadProps;

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth [scroll-padding-top:32px] motion-reduce:scroll-auto">
  <head>
    <BaseHead title={title} description={description} image={image} />
    <slot name="head" />
  </head>
  <body class="bg-[#f7f6f2] text-[#20231f]">
    <div class="mx-auto w-full max-w-[1600px] overflow-hidden bg-[#f7f6f2] px-[7.1%] font-['Helvetica_Neue',Helvetica,Arial,sans-serif] text-[#20231f] antialiased max-[900px]:px-[5%] max-[640px]:px-[22px]">
      <Navbar />
      <main id="top">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
