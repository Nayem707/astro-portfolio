---
import Layout from '../layouts/Layout.astro';

const contactDetails = [
  { label: 'Email', value: 'hello@jordanlee.design', href: 'mailto:hello@jordanlee.design' },
  { label: 'Instagram', value: '@jordanlee', href: 'https://www.instagram.com/' },
  { label: 'LinkedIn', value: 'Jordan Lee', href: 'https://www.linkedin.com/' },
];
---

<Layout title="Contact — Jordan Lee" description="Get in touch with Jordan Lee for design, product, and development work." currentPage="contact">
  <section class="py-12">
    <p class="mb-4 text-[10px] font-semibold uppercase tracking-[0.13em] text-[#777971]">Let's talk</p>
    <h1 class="mb-8 font-serif text-[clamp(46px,7vw,74px)] leading-[0.95] tracking-[-0.065em]">Open for thoughtful collaborations and select projects.</h1>

    <div class="rounded-[28px] bg-[#23261f] p-8 text-[#f7f6f2]">
      <p class="max-w-lg text-[17px] leading-[1.8] text-[#edf0e7]">
        I'm available for product design, brand direction, and front-end development work that values clarity, craft, and long-term thinking.
      </p>
      <a class="mt-8 inline-flex items-center gap-3 rounded-[30px] bg-[#d7f36a] px-[17px] py-[14px] text-[10px] font-semibold text-[#24271f] transition-all duration-200 hover:gap-[18px]" href="mailto:hello@jordanlee.design">
        Start a conversation <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <section class="grid gap-5 pb-16 md:grid-cols-3">
    {contactDetails.map((item) => (
      <a class="rounded-[24px] border border-[#e3e2dc] bg-[#faf9f5] p-6 transition-colors duration-200 hover:border-[#98b738]" href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined}>
        <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-[#777971]">{item.label}</p>
        <p class="mt-3 text-[18px] leading-[1.6] text-[#20231f]">{item.value}</p>
      </a>
    ))}
  </section>
</Layout>
