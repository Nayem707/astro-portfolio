---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';

const values = [
  'Thoughtful strategy that starts with real people, not trends.',
  'Design systems that feel warm, usable, and intuitive.',
  'Product thinking built around clarity, trust, and long-term craft.',
];
---

<Layout title="About" description="Learn more about Jordan Lee, an independent designer and developer creating thoughtful digital experiences.">
  <section class="py-10">
    <div class="grid items-center gap-10 md:grid-cols-[1.1fr_0.9fr]">
      <div>
        <Eyebrow class="mb-4" dot>About</Eyebrow>
        <h1 class="font-serif text-[clamp(46px,7vw,78px)] leading-[0.96] tracking-[-0.065em]">
          I design digital experiences that feel personal, useful, and alive.
        </h1>
      </div>
      <div class="rounded-[28px] bg-[#e1dfd5] p-6">
        <img class="block h-[420px] w-full rounded-[22px] object-cover object-center saturate-[0.7]" src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=1200&q=90" alt="Portrait of Jordan Lee" />
      </div>
    </div>
  </section>

  <section class="grid gap-8 py-8 md:grid-cols-2">
    <div class="rounded-[28px] border border-[#e3e2dc] bg-[#f7f6f2] p-8">
      <Eyebrow>Approach</Eyebrow>
      <p class="mt-5 text-[17px] leading-[1.8] text-[#4b5048]">
        I work best with founders, teams, and organizations that care deeply about how their work is felt by real people. My process blends strategy, design, and development so the final experience looks beautiful and works with intention.
      </p>
    </div>
    <div class="rounded-[28px] border border-[#e3e2dc] bg-[#d7f36a] p-8">
      <Eyebrow>Based in</Eyebrow>
      <p class="mt-5 font-serif text-[40px] leading-none tracking-[-0.05em]">Brooklyn, NY</p>
    </div>
  </section>

  <section class="py-10">
    <Eyebrow class="mb-6">What I value</Eyebrow>
    <div class="grid gap-5 md:grid-cols-3">
      {values.map((value) => (
        <article class="rounded-[24px] border border-[#e3e2dc] bg-[#faf9f5] p-6">
          <span class="mb-5 inline-flex h-10 w-10 items-center justify-center rounded-full bg-[#d7f36a] text-lg" aria-hidden="true">✳</span>
          <p class="text-[16px] leading-[1.7] text-[#4b5048]">{value}</p>
        </article>
      ))}
    </div>
  </section>
</Layout>
