---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { projects } from '../data/projects';
---

<Layout title="Projects" description="Explore recent portfolio projects and digital product work by Jordan Lee.">
  <PageHeader eyebrow="Selected work" title="Projects that invite attention and trust." />

  <section class="grid gap-6 pb-16 md:grid-cols-3">
    {projects.map((project) => (
      <article class="rounded-[28px] border border-[#e3e2dc] bg-[#faf9f5] p-6 transition-transform duration-200 hover:-translate-y-1">
        <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-full bg-[#d7f36a] font-serif text-[22px]">✳</div>
        <p class="mb-2 text-[10px] font-semibold uppercase tracking-[0.12em] text-[#777971]">{project.type}</p>
        <h2 class="mb-4 font-serif text-[30px] tracking-[-0.04em]">{project.name}</h2>
        <p class="text-[15px] leading-[1.8] text-[#5f615a]">{project.summary}</p>
      </article>
    ))}
  </section>
</Layout>
