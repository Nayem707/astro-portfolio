---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';

const skillGroups = [
  { title: 'Design', items: ['Brand systems', 'UX strategy', 'Art direction', 'Web design'] },
  { title: 'Development', items: ['Astro', 'HTML/CSS', 'JavaScript', 'UX engineering'] },
  { title: 'Process', items: ['Research', 'Prototyping', 'Iteration', 'Collaboration'] },
];
---

<Layout title="Skills" description="A snapshot of Jordan Lee's design, product, and development skills.">
  <PageHeader eyebrow="Capabilities" title="Thoughtful craft across strategy, design, and code." />

  <section class="grid gap-6 pb-16 md:grid-cols-3">
    {skillGroups.map((group) => (
      <article class="rounded-[28px] border border-[#e3e2dc] bg-[#faf9f5] p-6">
        <h2 class="mb-5 font-serif text-[28px] tracking-[-0.04em]">{group.title}</h2>
        <ul class="space-y-3 text-[15px] leading-[1.7] text-[#5f615a]">
          {group.items.map((item) => (
            <li class="flex items-center gap-3"><span class="inline-block h-2.5 w-2.5 rounded-full bg-[#98b738]"></span>{item}</li>
          ))}
        </ul>
      </article>
    ))}
  </section>
</Layout>
