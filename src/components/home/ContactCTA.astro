---
import { MAILTO } from '../../config/site';
---

<section class="bg-[#23261f] px-[6.2%] pt-[45px] pb-[50px] text-[#f7f6f2] max-[640px]:mx-[-22px] max-[640px]:px-[22px] max-[640px]:pt-[31px] max-[640px]:pb-9" aria-labelledby="contact-title">
  <div class="flex justify-between text-[9px] uppercase tracking-[0.08em] text-[#c4c5bc] max-[640px]:gap-3 max-[640px]:text-[8px]">
    <span>Have a good one in mind?</span>
    <span class="max-[640px]:text-right">Currently booking for 2026</span>
  </div>
  <h2 class="-ml-[5px] mt-[58px] mb-9 font-serif text-[clamp(54px,8.3vw,100px)] font-normal leading-[0.91] tracking-[-0.075em] max-[640px]:-ml-[3px] max-[640px]:mt-[54px] max-[640px]:mb-[30px] max-[640px]:text-[clamp(55px,12vw,76px)]" id="contact-title">Let's make<br /><em class="font-normal text-[#d7f36a]">something matter.</em></h2>
  <a class="inline-flex items-center gap-8 rounded-[30px] bg-[#d7f36a] px-[17px] py-[14px] text-[10px] font-semibold text-[#24271f] transition-all duration-200 hover:gap-[42px] hover:bg-[#e4ff8a] motion-reduce:transition-none" href={MAILTO}>
    Tell me about it <span aria-hidden="true">↗</span>
  </a>
</section>
