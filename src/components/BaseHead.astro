---
import { SITE } from '../config/site';

export interface Props {
  /** Page-specific title. Rendered as "{title} — Jordan Lee"; omit for the site default. */
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = SITE.description, image } = Astro.props;

const fullTitle = title ? `${title} — ${SITE.name}` : SITE.title;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const imageURL = image && Astro.site ? new URL(image, Astro.site) : image;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content={SITE.themeColor} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
{canonicalURL && <link rel="canonical" href={canonicalURL} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{canonicalURL && <meta property="og:url" content={canonicalURL} />}
{imageURL && <meta property="og:image" content={imageURL} />}

<meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{imageURL && <meta name="twitter:image" content={imageURL} />}
